---
// Shared page shell: title, meta description, fonts, footer
import '../styles/global.css';
const { title = 'LogLens', description = 'AI-assisted digital forensics: log timeline, AI summary and SHA-256 evidence check.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600;700&family=Noto+Sans+Devanagari:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans min-h-screen flex flex-col">
    <main class="flex-1 w-full max-w-4xl mx-auto px-4 py-6">
      <slot />
    </main>
    <footer class="border-t border-ink/15 text-sm text-muted px-4 py-4 text-center">
      SOLAR FLARES · HK26-0014 · CHAKRAVYUH 1.0 · AI summaries are generated by Gemini and can be wrong.
    </footer>
  </body>
</html>
