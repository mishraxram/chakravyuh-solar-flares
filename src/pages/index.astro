---
import Base from '../layouts/Base.astro';

// The 3 "Try sample" buttons (files live in public/samples, all made-up sample data)
const samples = [
  { file: '/samples/erp-marks-tamper.csv', label: 'ERP marks tampering' },
  { file: '/samples/ssh-bruteforce.log', label: 'Server SSH brute force' },
  { file: '/samples/hinglish-case.csv', label: 'Hinglish case note' },
];
---
<Base>
  <header class="flex items-center gap-3 mb-2">
    <h1 class="text-2xl font-bold">LogLens</h1>
  </header>
  <p class="mb-5 text-ink/80">Paste a server or ERP log. Get a red-flagged incident timeline, an AI summary, and SHA-256 proof the evidence was not changed.</p>

  <!-- Input -->
  <section class="bg-white border border-ink/15 rounded-md p-4 mb-6">
    <div class="flex flex-wrap gap-2 mb-3">
      <span class="text-sm text-muted self-center">Try sample:</span>
      {samples.map((s) => (
        <button type="button" data-sample={s.file} class="sample-btn text-sm border border-ink/30 rounded px-3 py-2 hover:bg-tag/30">
          {s.label}
        </button>
      ))}
    </div>
    <textarea id="log" rows="9" spellcheck="false"
      class="w-full font-mono text-sm border border-ink/20 rounded p-2 bg-paper/50"
      placeholder="Paste ERP audit CSV (time,user,role,ip,action,target,detail), Linux auth.log or Apache/Nginx access log lines here. Lines starting with # are case notes."></textarea>
    <div class="flex flex-wrap items-center gap-3 mt-3">
      <label class="btn-like text-sm border border-ink/30 rounded px-3 py-2 cursor-pointer hover:bg-tag/30 inline-flex items-center">
        Upload log or any evidence file <input id="file" type="file" class="sr-only" />
      </label>
      <button id="run" type="button" class="bg-ink text-paper font-semibold rounded px-4 py-2">Build timeline</button>
      <span id="msg" class="text-sm text-muted"></span>
    </div>
  </section>

  <!-- Evidence locker: the signature element (amber tag carrying the SHA-256) -->
  <section id="locker" class="hidden bg-white border border-ink/15 rounded-md p-4 mb-6">
    <div class="flex flex-wrap items-start gap-3">
      <div class="bg-tag text-ink rounded-sm px-3 py-2 font-mono text-xs max-w-full">
        <div class="font-semibold tracking-wide">EVIDENCE TAG · SHA-256</div>
        <div id="evName" class="mt-1"></div>
        <div id="evHash" class="break-all mt-1"></div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="verify" type="button" class="bg-ink text-paper font-semibold rounded px-4 py-2">Verify integrity</button>
        <button id="report" type="button" class="border border-ink/30 rounded px-4 py-2">Download report</button>
        <button id="newCase" type="button" class="text-sm text-muted underline px-2">New case</button>
        <input id="verifyFile" type="file" class="sr-only" aria-label="Choose the same file again to verify" />
      </div>
    </div>
    <div id="verifyOut" class="mt-3"></div>
    <details class="mt-3 text-xs">
      <summary class="cursor-pointer text-muted">Audit trail (hash-chained) <span id="chain" class="font-semibold"></span></summary>
      <button id="tamperAudit" type="button" class="mt-2 underline text-muted">Tamper test: secretly edit audit entry 1</button>
      <ol id="auditList" class="font-mono mt-1 space-y-0.5"></ol>
    </details>
  </section>

  <!-- Result -->
  <section id="result" class="hidden">
    <div id="notes" class="mb-3"></div>
    <div id="verdict" class="rounded-md p-3 mb-3 font-semibold"></div>
    <p id="stats" class="text-sm text-muted mb-2 font-mono"></p>

    <!-- AI investigation summary -->
    <div class="bg-white border border-ink/15 rounded-md p-4 mb-4">
      <div class="flex flex-wrap items-center gap-3">
        <button id="ai" type="button" class="bg-ink text-paper font-semibold rounded px-4 py-2">Analyze with AI</button>
        <label class="text-sm flex items-center gap-1"><input type="radio" name="lang" value="en" checked /> English</label>
        <label class="text-sm flex items-center gap-1"><input type="radio" name="lang" value="hi" /> हिंदी</label>
        <span id="aiMsg" class="text-sm text-muted"></span>
      </div>
      <p class="text-xs text-muted mt-2">Only the parsed event lines (max 200) are sent to Google Gemini. Raw files stay in your browser.</p>
      <div id="aiOut" class="mt-3"></div>
    </div>

    <label class="text-sm flex items-center gap-2 mb-2"><input id="onlyFlags" type="checkbox" /> Show only flagged events</label>
    <ol id="timeline" class="space-y-1.5"></ol>
  </section>
</Base>

<script>
  import { parseLog } from '../lib/parse.ts';
  import { applyRules, ruleVerdict } from '../lib/rules.ts';
  import { lockEvidence, verifyEvidence, getEvidence, getAudit, audit, clearCase, now, verifyAuditChain, lockFile, tamperAuditForDemo } from '../lib/evidence.ts';
  import { buildReport } from '../lib/report.ts';

  const $ = (id: string) => document.getElementById(id)!;
  const logBox = $('log') as HTMLTextAreaElement;
  const msg = $('msg');

  // Small helper: create an element with classes and safe text (no innerHTML = no XSS)
  function el(tag: string, cls: string, text = '') {
    const n = document.createElement(tag);
    n.className = cls;
    n.textContent = text;
    return n;
  }

  // Sample buttons: load the file into the box and run
  document.querySelectorAll<HTMLButtonElement>('.sample-btn').forEach((b) =>
    b.addEventListener('click', async () => {
      const res = await fetch(b.dataset.sample!);
      logBox.value = await res.text();
      await lockEvidence(b.dataset.sample!.split('/').pop()!, logBox.value);
      run();
    }),
  );

  // File upload: text logs go to the timeline; any other file (PDF, image...) is hashed as raw bytes
  const isTextLog = (f: File) => /\.(log|csv|txt)$/i.test(f.name) || f.type.startsWith('text/');
  ($('file') as HTMLInputElement).addEventListener('change', async (ev) => {
    const input = ev.target as HTMLInputElement;
    const f = input.files?.[0];
    input.value = ''; // allow choosing the same file again
    if (!f) return;
    if (!isTextLog(f)) {
      if (f.size > 50_000_000) { msg.textContent = 'File too big (max 50 MB).'; return; }
      msg.textContent = 'Hashing file…';
      await lockFile(f);
      msg.textContent = `${f.name} locked as evidence (not a text log, so no timeline).`;
      $('verifyOut').replaceChildren(); lastVerify = null;
      showLocker();
      return;
    }
    if (f.size > 2_000_000) { msg.textContent = 'Log too big (max 2 MB).'; return; }
    logBox.value = await f.text();
    await lockEvidence(f.name, logBox.value);
    run();
  });

  // ---- Evidence locker ----
  let lastAi: AiResult | null = null;
  let lastVerify: { match: boolean; current: string } | null = null;

  async function showLocker() {
    const ev = getEvidence();
    $('locker').classList.toggle('hidden', !ev);
    if (!ev) return;
    $('evName').textContent = `${ev.name} · ${ev.size} bytes${ev.kind === 'file' ? ` · ${ev.type} · modified ${ev.lastModified}` : ''} · locked ${ev.lockedAt}`;
    $('evHash').textContent = ev.hash;
    const list = $('auditList'); list.replaceChildren();
    getAudit().forEach((a, i) => list.append(el('li', '', `${i + 1}. ${a.at}  ${a.action}  ${a.detail}  [${a.hash.slice(0, 10)}…]`)));
    const broken = await verifyAuditChain();
    const chain = $('chain');
    chain.textContent = broken ? `· CHAIN BROKEN at entry ${broken}` : `· chain OK (${getAudit().length} entries)`;
    chain.className = broken ? 'font-semibold text-flag' : 'font-semibold text-match';
    if (broken) ($('chain').parentElement!.parentElement as HTMLDetailsElement).open = true;
  }

  // Text evidence: compare with the box. File evidence: ask for the file again and compare its bytes.
  $('verify').addEventListener('click', () => {
    if (getEvidence()?.kind === 'file') ($('verifyFile') as HTMLInputElement).click();
    else verifyEvidence(logBox.value).then(showVerify);
  });
  ($('verifyFile') as HTMLInputElement).addEventListener('change', async (ev) => {
    const input = ev.target as HTMLInputElement;
    const f = input.files?.[0];
    input.value = '';
    if (f) showVerify(await verifyEvidence(await f.arrayBuffer()));
  });

  function showVerify(r: Awaited<ReturnType<typeof verifyEvidence>>) {
    if (!r) return;
    lastVerify = r;
    const out = $('verifyOut'); out.replaceChildren();
    if (r.match) {
      out.append(el('p', 'p-3 rounded bg-match text-white font-semibold', 'MATCH: evidence unchanged since it was locked.'));
    } else {
      out.append(el('p', 'p-3 rounded bg-flag text-white font-semibold', 'TAMPERED: hash mismatch. The evidence changed after it was locked.'));
      out.append(el('p', 'font-mono text-xs break-all mt-2', `Locked: ${r.original}`), el('p', 'font-mono text-xs break-all text-flag', `Now:    ${r.current}`));
    }
    showLocker();
  }

  $('tamperAudit').addEventListener('click', () => { tamperAuditForDemo(); showLocker(); });

  $('report').addEventListener('click', async () => {
    await audit('REPORT_DOWNLOADED', 'HTML report generated');
    const html = buildReport({ evidence: getEvidence(), verify: lastVerify, events: last?.events ?? [], notes: last?.notes ?? [], ai: lastAi, audit: getAudit(), chainBrokenAt: await verifyAuditChain(), generatedAt: now() });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
    a.download = `loglens-report-${getEvidence()?.hash.slice(0, 8) ?? 'case'}.html`;
    a.click();
    showLocker();
  });

  $('newCase').addEventListener('click', () => {
    clearCase(); lastAi = null; lastVerify = null; last = null;
    logBox.value = ''; $('verifyOut').replaceChildren(); $('aiOut').replaceChildren();
    $('result').classList.add('hidden'); showLocker();
  });

  showLocker(); // restore a case saved in this browser

  $('run').addEventListener('click', run);
  $('onlyFlags').addEventListener('change', run);
  $('ai').addEventListener('click', analyze);

  // Last parsed result, reused by the AI step
  let last: ReturnType<typeof parseLog> | null = null;

  type AiResult = { source: string; verdict: string; hidden_patterns?: { events: number[]; text: string }[]; model?: string; summary: string; indicators: { events: number[]; text: string }[]; confidence: string; next_steps: string[] };

  // Ask the server (which asks Gemini). On any failure, fall back to a summary built from the rules.
  async function analyze() {
    if (!last || !last.events.length) { $('aiMsg').textContent = 'Build a timeline first.'; return; }
    const lang = (document.querySelector('input[name=lang]:checked') as HTMLInputElement).value;
    const btn = $('ai') as HTMLButtonElement;
    btn.disabled = true; $('aiMsg').textContent = 'Asking Gemini… (up to 8s)'; $('aiOut').replaceChildren();
    // Send flagged events first so they survive the 200-event limit
    const sorted = [...last.events].sort((a, b) => Number(b.flags.length > 0) - Number(a.flags.length > 0)).slice(0, 200).sort((a, b) => a.n - b.n);
    const events = sorted.map(({ time, raw, flags, ...e }) => ({ ...e, flags: flags.map((f) => f.reason) }));
    let result: AiResult;
    try {
      const res = await fetch('/api/analyze', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ events, notes: last.notes, lang }) });
      const data = await res.json();
      if (!res.ok || !data.summary) throw new Error(data.error || 'AI failed');
      result = data;
      $('aiMsg').textContent = '';
    } catch (err) {
      result = offlineSummary();
      $('aiMsg').textContent = `AI unavailable (${(err as Error).message}).`;
    }
    btn.disabled = false;
    lastAi = result;
    await audit(result.source === 'ai' ? 'AI_SUMMARY' : 'OFFLINE_SUMMARY', `${result.model ?? 'rules'} · confidence ${result.confidence} · ${lang}`);
    showLocker();
    showAi(result);
  }

  // Offline fallback: real findings from the rules, clearly labelled as not AI
  function offlineSummary(): AiResult {
    const flagged = last!.events.filter((e) => e.flags.length);
    // Group by rule: one indicator per rule, citing every event it matched (high-severity rules first)
    const byCode = new Map<string, { text: string; high: boolean; ns: number[] }>();
    flagged.forEach((e) => e.flags.forEach((f) => {
      const g = byCode.get(f.code) ?? { text: f.reason, high: f.severity === 'high', ns: [] };
      g.ns.push(e.n); byCode.set(f.code, g);
    }));
    const groups = [...byCode.values()].sort((a, b) => Number(b.high) - Number(a.high));
    return {
      source: 'offline',
      verdict: flagged.some((e) => e.flags.some((f) => f.severity === 'high')) ? 'suspicious' : 'unsure',
      summary: flagged.length ? `Rules flagged ${flagged.length} of ${last!.events.length} events. Review the indicators below.` : 'Rules found nothing suspicious.',
      indicators: groups.slice(0, 6).map((g) => ({ events: g.ns, text: g.text })),
      confidence: flagged.length >= 3 ? 'medium' : 'low',
      hidden_patterns: [],
      next_steps: ['Retry the AI summary in a minute.', 'Collect server auth logs and database audit logs for the same time window.'],
    };
  }

  function showAi(r: AiResult) {
    const out = $('aiOut'); out.replaceChildren();
    const label = r.source === 'ai'
      ? `AI generated (Gemini · ${r.model}). Can be wrong: check the cited events.`
      : 'Offline summary from rules (AI unavailable). Not AI generated.';
    out.append(el('p', `text-xs font-mono mb-2 inline-block px-2 py-0.5 rounded-sm ${r.source === 'ai' ? 'bg-tag/40' : 'bg-ink/10'}`, label));
    if (r.confidence === 'low' || r.verdict === 'unsure')
      out.append(el('p', 'mb-2 p-2 rounded bg-tag/30 text-sm', 'Not enough evidence for a clear answer. Next: collect auth logs and database audit logs for the same time window, then run again.'));
    // Verdict chip: status colours only (red incident, amber suspicious, green normal, grey unsure)
    const vc: Record<string, string> = { incident: 'bg-flag text-white', suspicious: 'bg-tag/50', normal: 'bg-match text-white', unsure: 'bg-ink/10' };
    out.append(el('p', `block w-fit font-semibold uppercase rounded px-2 py-1 mb-2 ${vc[r.verdict] ?? vc.unsure}`, `Verdict: ${r.verdict} · confidence ${r.confidence}`));
    out.append(el('p', 'mb-2', r.summary));
    const ul = el('ul', 'space-y-1 mb-3 text-sm');
    r.indicators.forEach((i) => {
      const li = el('li', 'border-l-4 border-flag pl-2');
      li.append(el('span', 'font-mono font-semibold mr-2', i.events.map((n) => `#${n}`).join(' ')), document.createTextNode(i.text));
      ul.append(li);
    });
    out.append(ul);
    // What the AI found that the rules did not say (the "AI-based pattern discovery" part)
    if (r.hidden_patterns?.length) {
      const box = el('div', 'mb-3 p-3 rounded border-2 border-dashed border-tag');
      box.append(el('p', 'text-sm font-semibold mb-1', 'AI found beyond the rules'));
      r.hidden_patterns.forEach((h) => { const p = el('p', 'text-sm'); p.append(el('span', 'font-mono font-semibold mr-2', h.events.map((n) => `#${n}`).join(' ')), document.createTextNode(h.text)); box.append(p); });
      out.append(box);
    }
    out.append(el('p', 'text-sm font-semibold', 'Next steps'));
    const steps = el('ol', 'list-decimal pl-5 text-sm');
    r.next_steps.forEach((s) => steps.append(el('li', '', s)));
    out.append(steps);
  }

  async function run() {
    const text = logBox.value;
    if (!text.trim()) { msg.textContent = 'Paste a log or try a sample.'; $('result').classList.add('hidden'); return; }
    msg.textContent = '';
    if (!getEvidence()) await lockEvidence('pasted-log.txt', text); // pasted text becomes evidence on first run
    const parsed = parseLog(text);
    const events = applyRules(parsed.events);
    if (last?.events.map((e) => e.raw).join() !== events.map((e) => e.raw).join()) $('aiOut').replaceChildren();
    last = parsed;
    const v = ruleVerdict(events);

    // Case notes (# lines)
    const notes = $('notes'); notes.replaceChildren();
    parsed.notes.forEach((n) => notes.append(el('p', 'text-sm italic text-ink/80 border-l-4 border-tag pl-2 mb-1', n)));

    // Verdict
    const verdict = $('verdict');
    if (events.length === 0) {
      verdict.className = 'rounded-md p-3 mb-3 font-semibold bg-ink/10';
      verdict.textContent = 'Not a supported log. Use ERP audit CSV, Linux auth.log or Apache/Nginx access log, or try a sample.';
    } else if (v.level === 'none') {
      verdict.className = 'rounded-md p-3 mb-3 font-semibold bg-match/15 text-match';
      verdict.textContent = 'No suspicious pattern found by the rules. (Rules can miss things: run the AI summary or check more logs.)';
    } else {
      verdict.className = `rounded-md p-3 mb-3 font-semibold ${v.level === 'high' ? 'bg-flag text-white' : 'bg-tag/40'}`;
      verdict.textContent = `${v.level.toUpperCase()} RISK: ${v.high} high-risk and ${v.medium} medium-risk events flagged by rules`;
    }
    $('stats').textContent = `${events.length} events parsed · ${parsed.unparsed.length} lines not understood · sorted by time`;

    // Timeline
    const list = $('timeline'); list.replaceChildren();
    const onlyFlags = ($('onlyFlags') as HTMLInputElement).checked;
    for (const e of events) {
      if (onlyFlags && !e.flags.length) continue;
      const high = e.flags.some((f) => f.severity === 'high');
      const li = el('li', `rounded border p-2 text-sm ${high ? 'border-flag bg-flag/10' : e.flags.length ? 'border-tag bg-tag/15' : 'border-ink/10 bg-white'}`);
      const top = el('div', 'flex flex-wrap gap-x-3 font-mono text-xs');
      top.append(el('span', 'font-semibold', `#${e.n}`), el('span', '', e.timeText), el('span', 'font-semibold', e.user || '-'),
        el('span', 'text-muted', e.role), el('span', '', e.ip), el('span', 'font-semibold', e.action), el('span', 'text-ink/70', `${e.target} ${e.detail}`));
      li.append(top);
      for (const f of e.flags) li.append(el('p', `mt-1 ${f.severity === 'high' ? 'text-flag font-semibold' : 'text-ink/80'}`, `⚑ ${f.reason}`));
      list.append(li);
    }
    if (parsed.unparsed.length) {
      const d = el('details', 'mt-3 text-xs');
      d.append(el('summary', 'cursor-pointer text-muted', `${parsed.unparsed.length} lines not understood (kept, not dropped)`));
      parsed.unparsed.slice(0, 50).forEach((u) => d.append(el('pre', 'font-mono whitespace-pre-wrap', u)));
      list.append(d);
    }
    $('result').classList.remove('hidden');
    await audit('TIMELINE_BUILT', `${events.length} events · ${v.high} high · ${v.medium} medium · ${parsed.unparsed.length} not understood`);
    showLocker();
  }
</script>
